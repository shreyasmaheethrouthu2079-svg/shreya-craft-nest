# ==========================================
# Shreya Crafts Nest - Environment Configuration
# ==========================================

# 1. Razorpay Payment Gateway Credentials
# Obtain these from your Razorpay Dashboard: https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET_HERE

# 2. Google Sheets Webhook Integration (Optional)
# If you want every verified order to be automatically saved as a row in Google Sheets,
# deploy a Google Apps Script Web App and paste the execution URL here:
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# 3. Store WhatsApp Contact Details
# Used for pre-filling WhatsApp customer inquiry and direct order confirmation messages
NEXT_PUBLIC_STORE_WHATSAPP_NUMBER=919876543210
